{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/booking/availability", "destination": "/api/public?route=availability" },
    { "source": "/api/booking/available-slots", "destination": "/api/public?route=available-slots" },
    { "source": "/api/products", "destination": "/api/public?route=products" },
    { "source": "/api/notifications/active", "destination": "/api/public?route=notifications" },
    { "source": "/api/promo/validate", "destination": "/api/public?route=promo" },
    { "source": "/bm", "destination": "/bm.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/space", "destination": "/space.html" },
    { "source": "/update", "destination": "/update.html" },
    { "source": "/consultation", "destination": "/consultation.html" },
    { "source": "/store", "destination": "/store.html" },
    { "source": "/os", "destination": "/os.html" }
  ],
  "redirects": [
    { "source": "/service", "destination": "/bm", "permanent": true },
    { "source": "/start", "destination": "/update", "permanent": true },
    { "source": "/scale", "destination": "/consultation", "permanent": true },
    { "source": "/system", "destination": "/os", "permanent": true },
    { "source": "/rpn", "destination": "/space", "permanent": true }
  ]
}
