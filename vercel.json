{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": { "maxDuration": 30, "includeFiles": "data/promos.json" }
  },
  "rewrites": [
    { "source": "/service", "destination": "/service.html" },
    { "source": "/space", "destination": "/space.html" },
    { "source": "/start", "destination": "/start.html" },
    { "source": "/scale", "destination": "/scale.html" },
    { "source": "/store", "destination": "/store.html" }
    ,{ "source": "/system", "destination": "/system.html" }
  ]
}
