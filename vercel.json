{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/bm", "destination": "/bm.html" },
    { "source": "/rpn", "destination": "/rpn.html" },
    { "source": "/update", "destination": "/update.html" }
  ]
}
