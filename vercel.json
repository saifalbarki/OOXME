{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": { "maxDuration": 30, "includeFiles": "data/promos.json" }
  },
  "rewrites": [
    { "source": "/bm", "destination": "/bm.html" },
    { "source": "/rpn", "destination": "/rpn.html" },
    { "source": "/update", "destination": "/update.html" },
    { "source": "/consultation", "destination": "/consultation.html" },
    { "source": "/store", "destination": "/store.html" }
    ,{ "source": "/os", "destination": "/os.html" }
  ]
}
